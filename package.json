{
	"name": "spidersense",
	"private": true,
	"version": "0.0.1",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('.svelte-kit', { recursive: true, force: true })\"",
		"dev": "pnpm clean && pnpm build:wasm:dev && vite dev",
		"build": "pnpm clean && pnpm build:wasm && wrangler types --check && vite build",
		"build:wasm": "wasm-pack build crates/spidersense-wasm --target web --out-dir ../../src/lib/wasm --out-name spidersense_wasm --release",
		"build:wasm:dev": "wasm-pack build crates/spidersense-wasm --target web --out-dir ../../src/lib/wasm --out-name spidersense_wasm --dev",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm check:rust && pnpm check:web",
		"check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings",
		"check:web": "pnpm clean && pnpm build:wasm:dev && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"audit": "pnpm audit --audit-level high",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && cargo fmt",
		"test:e2e": "playwright test --pass-with-no-tests",
		"gen": "wrangler types",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	}
}
